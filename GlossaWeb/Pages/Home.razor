@page "/"
@namespace GlossaWeb.Pages
@using GlossaWeb.Models
@using GlossaWeb.Services
@implements IDisposable

@inject IThemeService ThemeService
@inject ILocalizationService Loc
@inject IFileService FileService
@inject IEditorInteropService EditorService
@inject IGlossaExecutionService ExecutionService
@inject IJSRuntime JS

<div class="ide-root"
     tabindex="0"
     @onkeydown="HandleGlobalKeyDown"
     @onmousemove="HandleMouseMove"
     @onmouseup="HandleMouseUp">

    <!-- Top Action Toolbar -->
    <Toolbar OnNew="CreateNewTabAsync"
             OnOpen="OpenFileAsync"
             OnOpenFolder="OpenFolderAsync"
             OnSave="SaveFileAsync"
             OnSaveAs="SaveAsFileAsync"
             OnUndo="() => EditorService.UndoAsync()"
             OnRedo="() => EditorService.RedoAsync()"
             OnCut="CutAsync"
             OnCopy="CopyAsync"
             OnPaste="PasteAsync"
             OnFormat="() => EditorService.FormatDocumentAsync()"
             OnRun="RunProgramAsync"
             OnStop="() => ExecutionService.StopAsync()"
             OnClearConsole="ClearConsole"
             OnToggleTheme="ToggleThemeAsync"
             OnShowAbout="ShowAboutSection"
             IsRunning="@(ExecutionService.State == ExecutionState.Running || ExecutionService.State == ExecutionState.WaitingForInput)"
             IsDirty="@ActiveTab.IsDirty"
             ThemeIcon="@(ThemeService.CurrentTheme == ThemeMode.Light ? "bi-sun-fill" : "bi-moon-stars-fill")" />

    <!-- Main Workspace Body -->
    <div class="ide-body">
        <!-- Left Activity Bar -->
        <ActivityBar ActivePanel="@activeSidebarPanel"
                     IsSidebarVisible="@isSidebarVisible"
                     OnPanelSelected="HandlePanelSelected" />

        <!-- Collapsible Sidebar -->
        <Sidebar ActivePanel="@activeSidebarPanel"
                 IsVisible="@isSidebarVisible"
                 Tabs="@tabs"
                 ActiveTabId="@activeTabId"
                 OpenedFolder="@openedFolder"
                 Settings="@editorSettings"
                 OnTabSelected="SelectTabAsync"
                 OnSampleSelected="LoadSampleInNewTabAsync"
                 OnFileItemClicked="OpenFileFromTreeAsync"
                 OnSettingsChanged="HandleSettingsChanged"
                 OnCloseSidebar="() => isSidebarVisible = false" />

        <!-- Center Editor + Bottom Output Panel -->
        <main class="ide-main">
            <!-- Code Editor Area with Multiple Tabs Strip -->
            <CodeEditor ContainerId="monaco-editor-container"
                        Tabs="@tabs"
                        ActiveTabId="@activeTabId"
                        OnTabSelected="SelectTabAsync"
                        OnTabClosed="RequestCloseTabAsync"
                        OnNewTab="CreateNewTabAsync"
                        OnTabRenamed="HandleTabRenamed" />

            <!-- Resizer Handle -->
            <div class="resizer-v @(isDraggingResizer ? "dragging" : "")"
                 @onmousedown="StartResizing"
                 title="Drag to resize panel height"></div>

            <!-- Bottom Terminal / Problems Panel -->
            <TerminalPanel IsVisible="@isPanelVisible"
                           HeightPx="@panelHeightPx"
                           ActiveTab="@activePanelTab"
                           OnTabChanged="@(tab => activePanelTab = tab)"
                           OnToggleVisibility="@(() => isPanelVisible = !isPanelVisible)"
                           OnClear="ClearActivePanelTab"
                           OnProblemSelected="NavigateToProblem"
                           TerminalLines="@terminalLines"
                           Diagnostics="@diagnostics"
                           BuildLogs="@buildLogs"
                           IsWaitingForInput="@(ExecutionService.State == ExecutionState.WaitingForInput)"
                           OnInputSubmitted="HandleInputSubmitted" />
        </main>
    </div>

    <!-- Bottom Status Bar -->
    <StatusBar Line="@cursorPosition.Line"
               Column="@cursorPosition.Column"
               State="@ExecutionService.State"
               FileName="@ActiveTab.FileName"
               ThemeName="@ThemeService.CssThemeName"
               ProblemCount="@diagnostics.Count" />

    <!-- Modal Dialog: Unsaved Changes Confirmation -->
    @if (showUnsavedModal && pendingCloseTab != null)
    {
        <div class="modal-backdrop">
            <div class="modal-dialog">
                <div class="modal-header">
                    <span>@Loc["UnsavedTitle"]</span>
                    <button class="panel-action-btn" @onclick="CancelCloseTab">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    @Loc.Format("UnsavedPrompt", pendingCloseTab.FileName)
                    <div style="color:var(--text-secondary); font-size:12px; margin-top:6px;">
                        @Loc["UnsavedWarning"]
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="modal-btn btn-primary" @onclick="SaveAndClosePendingTabAsync">@Loc["BtnSave"]</button>
                    <button class="modal-btn btn-danger" @onclick="DiscardAndClosePendingTab">@Loc["BtnDontSave"]</button>
                    <button class="modal-btn" @onclick="CancelCloseTab">@Loc["BtnCancel"]</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<EditorTab> tabs = new();
    private string activeTabId = "";
    private int untitledCounter = 1;

    private EditorTab ActiveTab => tabs.FirstOrDefault(t => t.Id == activeTabId) ?? tabs.First();

    private WorkspaceFolder? openedFolder;
    private EditorSettings editorSettings = new();
    private CursorPosition cursorPosition = new();
    private List<TerminalLine> terminalLines = new();
    private List<DiagnosticEntry> diagnostics = new();
    private List<string> buildLogs = new();

    private string activeSidebarPanel = "explorer";
    private bool isSidebarVisible = true;
    private bool isPanelVisible = true;
    private int panelHeightPx = 230;
    private BottomPanelTab activePanelTab = BottomPanelTab.Terminal;

    // Unsaved changes confirmation dialog state
    private bool showUnsavedModal = false;
    private EditorTab? pendingCloseTab = null;

    // Resizer dragging state
    private bool isDraggingResizer = false;
    private double startMouseY;
    private int startHeight;

    private const string DefaultProgramTemplate = @"ΠΡΟΓΡΑΜΜΑ Υπολογισμος_Εμβαδου
! --------------------------------------------------
! Educational rectangle area calculation in ΓΛΩΣΣΑ
! Modern Blazor WebAssembly IDE
! --------------------------------------------------
ΜΕΤΑΒΛΗΤΕΣ
  ΠΡΑΓΜΑΤΙΚΕΣ: μηκος, πλατος, εμβαδον
ΑΡΧΗ
  ΓΡΑΨΕ '=== Rectangle Area Calculator ==='
  ΓΡΑΨΕ 'Enter length (in meters):'
  ΔΙΑΒΑΣΕ μηκος

  ΓΡΑΨΕ 'Enter width (in meters):'
  ΔΙΑΒΑΣΕ πλατος

  ΑΝ μηκος > 0 ΚΑΙ πλατος > 0 ΤΟΤΕ
    εμβαδον <- μηκος * πλατος
    ΓΡΑΨΕ 'The rectangle area is: ', εμβαδον, ' sq.m.'
  ΑΛΛΙΩΣ
    ΓΡΑΨΕ 'Error: Dimensions must be positive numbers!'
  ΤΕΛΟΣ_ΑΝ
ΤΕΛΟΣ_ΠΡΟΓΡΑΜΜΑΤΟΣ
";

    protected override void OnInitialized()
    {
        // Initialize default tab
        var initialTab = new EditorTab("program.glo", DefaultProgramTemplate);
        tabs.Add(initialTab);
        activeTabId = initialTab.Id;

        ThemeService.OnThemeChanged += HandleThemeChanged;
        Loc.OnLanguageChanged += HandleLanguageChanged;
        EditorService.OnContentChanged += HandleContentChanged;
        EditorService.OnCursorChanged += HandleCursorChanged;

        ExecutionService.OnStdOut += HandleStdOut;
        ExecutionService.OnStdErr += HandleStdErr;
        ExecutionService.OnInputRequested += HandleInputRequested;
        ExecutionService.OnStateChanged += HandleStateChanged;
        ExecutionService.OnDiagnosticsUpdated += HandleDiagnosticsUpdated;

        buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Glossa IDE initialized.");
        buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Compiler engine ready.");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Loc.InitializeAsync();
            await ThemeService.InitializeAsync();
            await ExecutionService.InitializeAsync();
            await EditorService.InitializeAsync("monaco-editor-container", ActiveTab.Id, ActiveTab.Content, ThemeService.MonacoThemeName);
        }
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void HandleThemeChanged()
    {
        await EditorService.SetThemeAsync(ThemeService.MonacoThemeName);
        await InvokeAsync(StateHasChanged);
    }

    private void HandleContentChanged(string tabId, string newContent)
    {
        var targetTab = tabs.FirstOrDefault(t => t.Id == tabId) ?? ActiveTab;
        targetTab.Content = newContent;
        InvokeAsync(StateHasChanged);
    }

    private void HandleCursorChanged(int line, int col)
    {
        cursorPosition.Line = line;
        cursorPosition.Column = col;
        InvokeAsync(StateHasChanged);
    }

    private void HandleStdOut(string line)
    {
        terminalLines.Add(new TerminalLine(line, TerminalLineType.Output));
        InvokeAsync(StateHasChanged);
    }

    private void HandleStdErr(string line)
    {
        terminalLines.Add(new TerminalLine(line, TerminalLineType.Error));
        InvokeAsync(StateHasChanged);
    }

    private void HandleInputRequested()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleStateChanged(ExecutionState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private async void HandleDiagnosticsUpdated(List<DiagnosticEntry> diags)
    {
        diagnostics = diags;
        await EditorService.SetMarkersAsync(diags);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void ShowAboutSection()
    {
        activeSidebarPanel = "about";
        isSidebarVisible = true;
    }

    private void HandlePanelSelected(string panel)
    {
        if (string.IsNullOrEmpty(panel))
        {
            isSidebarVisible = false;
        }
        else
        {
            activeSidebarPanel = panel;
            isSidebarVisible = true;
        }
    }

    private async Task HandleSettingsChanged(EditorSettings newSettings)
    {
        editorSettings = newSettings;
        await EditorService.UpdateOptionsAsync(editorSettings);
    }

    // --------------------------------------------------------------------------
    // Multiple Tabs Management
    // --------------------------------------------------------------------------
    private async Task SelectTabAsync(string tabId)
    {
        if (activeTabId == tabId) return;

        var tab = tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab != null)
        {
            activeTabId = tab.Id;
            await EditorService.SwitchTabAsync(tab.Id, tab.Content);
            await EditorService.ClearMarkersAsync();
            diagnostics.Clear();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateNewTabAsync()
    {
        var newName = $"untitled{++untitledCounter}.glo";
        var newTab = new EditorTab(newName, "ΠΡΟΓΡΑΜΜΑ Νεο_Προγραμμα\nΜΕΤΑΒΛΗΤΕΣ\n  ΑΚΕΡΑΙΕΣ: x\nΑΡΧΗ\n  ΓΡΑΨΕ 'Hello from Glossa'\nΤΕΛΟΣ_ΠΡΟΓΡΑΜΜΑΤΟΣ\n");
        tabs.Add(newTab);
        activeTabId = newTab.Id;

        await EditorService.SwitchTabAsync(newTab.Id, newTab.Content);
        buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Created tab: {newName}");
        await InvokeAsync(StateHasChanged);
    }

    private Task RequestCloseTabAsync(EditorTab tab)
    {
        if (tab.IsDirty)
        {
            pendingCloseTab = tab;
            showUnsavedModal = true;
            return Task.CompletedTask;
        }

        return CloseTabDirectlyAsync(tab);
    }

    private async Task CloseTabDirectlyAsync(EditorTab tab)
    {
        var tabIndex = tabs.IndexOf(tab);
        tabs.Remove(tab);
        await EditorService.CloseTabAsync(tab.Id);

        if (tabs.Count == 0)
        {
            // If all tabs were closed, create a fresh default tab
            var freshTab = new EditorTab("program.glo", DefaultProgramTemplate);
            tabs.Add(freshTab);
            activeTabId = freshTab.Id;
            await EditorService.SwitchTabAsync(freshTab.Id, freshTab.Content);
        }
        else if (activeTabId == tab.Id)
        {
            // Switch to adjacent tab
            var newIndex = Math.Clamp(tabIndex, 0, tabs.Count - 1);
            var nextTab = tabs[newIndex];
            activeTabId = nextTab.Id;
            await EditorService.SwitchTabAsync(nextTab.Id, nextTab.Content);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAndClosePendingTabAsync()
    {
        if (pendingCloseTab != null)
        {
            var tabToClose = pendingCloseTab;
            showUnsavedModal = false;
            pendingCloseTab = null;

            var result = await FileService.SaveFileAsync(tabToClose.FileName, tabToClose.Content);
            if (result.Success)
            {
                tabToClose.SavedContent = tabToClose.Content;
            }
            await CloseTabDirectlyAsync(tabToClose);
        }
    }

    private async Task DiscardAndClosePendingTab()
    {
        if (pendingCloseTab != null)
        {
            var tabToClose = pendingCloseTab;
            showUnsavedModal = false;
            pendingCloseTab = null;
            await CloseTabDirectlyAsync(tabToClose);
        }
    }

    private void CancelCloseTab()
    {
        showUnsavedModal = false;
        pendingCloseTab = null;
    }

    private void HandleTabRenamed((EditorTab Tab, string NewName) args)
    {
        args.Tab.FileName = args.NewName;
        buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Renamed tab to: {args.NewName}");
        StateHasChanged();
    }

    // --------------------------------------------------------------------------
    // File & Folder Operations
    // --------------------------------------------------------------------------
    private async Task OpenFileAsync()
    {
        var result = await FileService.OpenFileAsync();
        if (result.HasValue)
        {
            // Check if file is already open in a tab
            var existing = tabs.FirstOrDefault(t => t.FileName == result.Value.Name);
            if (existing != null)
            {
                await SelectTabAsync(existing.Id);
                return;
            }

            var newTab = new EditorTab(result.Value.Name, result.Value.Content);
            tabs.Add(newTab);
            activeTabId = newTab.Id;
            await EditorService.SwitchTabAsync(newTab.Id, newTab.Content);
            buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Opened file: {result.Value.Name}");
        }
    }

    private async Task OpenFolderAsync()
    {
        var folder = await FileService.OpenDirectoryAsync();
        if (folder != null)
        {
            openedFolder = folder;
            activeSidebarPanel = "explorer";
            isSidebarVisible = true;
            buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Opened folder workspace: {folder.Name}");
            StateHasChanged();
        }
    }

    private async Task OpenFileFromTreeAsync(WorkspaceItem item)
    {
        if (item.IsDirectory) return;

        // Check if tab already exists
        var existing = tabs.FirstOrDefault(t => t.FilePath == item.RelativePath || t.FileName == item.Name);
        if (existing != null)
        {
            await SelectTabAsync(existing.Id);
            return;
        }

        var newTab = new EditorTab(item.Name, item.Content ?? "", item.RelativePath);
        tabs.Add(newTab);
        activeTabId = newTab.Id;
        await EditorService.SwitchTabAsync(newTab.Id, newTab.Content);
        buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Opened from workspace: {item.Name}");
    }

    private async Task SaveFileAsync()
    {
        var result = await FileService.SaveFileAsync(ActiveTab.FileName, ActiveTab.Content);
        if (result.Success)
        {
            ActiveTab.FileName = result.FileName;
            var currentContent = await EditorService.GetContentAsync();
            ActiveTab.Content = currentContent;
            ActiveTab.SavedContent = currentContent;
            buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Saved file: {ActiveTab.FileName}");
            StateHasChanged();
        }
    }

    private async Task SaveAsFileAsync()
    {
        // Calling SaveAsFileAsync directly preserves the transient user gesture for showSaveFilePicker
        var result = await FileService.SaveAsFileAsync(ActiveTab.FileName, ActiveTab.Content);
        if (result.Success)
        {
            ActiveTab.FileName = result.FileName;
            var currentContent = await EditorService.GetContentAsync();
            ActiveTab.Content = currentContent;
            ActiveTab.SavedContent = currentContent;
            buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Saved as: {ActiveTab.FileName}");
            StateHasChanged();
        }
    }

    private async Task LoadSampleInNewTabAsync((string Title, string Code) sample)
    {
        var fileName = sample.Title.Replace(" ", "_").Replace(".", "") + ".glo";
        var newTab = new EditorTab(fileName, sample.Code);
        tabs.Add(newTab);
        activeTabId = newTab.Id;

        await EditorService.SwitchTabAsync(newTab.Id, newTab.Content);
        await EditorService.ClearMarkersAsync();
        diagnostics.Clear();
        buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Loaded sample program: {sample.Title}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task CutAsync()
    {
        var text = await EditorService.GetSelectedTextAsync();
        if (!string.IsNullOrEmpty(text))
        {
            await FileService.CopyToClipboardAsync(text);
            await EditorService.InsertTextAsync("");
        }
    }

    private async Task CopyAsync()
    {
        var text = await EditorService.GetSelectedTextAsync();
        if (!string.IsNullOrEmpty(text))
        {
            await FileService.CopyToClipboardAsync(text);
        }
    }

    private async Task PasteAsync()
    {
        var text = await FileService.ReadFromClipboardAsync();
        if (!string.IsNullOrEmpty(text))
        {
            await EditorService.InsertTextAsync(text);
        }
    }

    // --------------------------------------------------------------------------
    // Program Execution
    // --------------------------------------------------------------------------
    private async Task RunProgramAsync()
    {
        var content = await EditorService.GetContentAsync();
        if (string.IsNullOrWhiteSpace(content)) return;

        ActiveTab.Content = content;

        activePanelTab = BottomPanelTab.Terminal;
        isPanelVisible = true;

        terminalLines.Clear();
        terminalLines.Add(new TerminalLine($"=== Running: {ActiveTab.FileName} [{DateTime.Now:HH:mm:ss}] ===", TerminalLineType.Info));
        buildLogs.Add($"[{DateTime.Now:HH:mm:ss}] Compiling and executing {ActiveTab.FileName}...");

        await ExecutionService.RunAsync(content);
    }

    private async Task HandleInputSubmitted(string input)
    {
        terminalLines.Add(new TerminalLine($"> {input}", TerminalLineType.Input));
        await ExecutionService.SendInputAsync(input);
    }

    private void ClearConsole()
    {
        terminalLines.Clear();
    }

    private void ClearActivePanelTab()
    {
        if (activePanelTab == BottomPanelTab.Terminal)
            terminalLines.Clear();
        else if (activePanelTab == BottomPanelTab.Problems)
            diagnostics.Clear();
        else if (activePanelTab == BottomPanelTab.BuildOutput)
            buildLogs.Clear();
    }

    private async Task NavigateToProblem(DiagnosticEntry diag)
    {
        await EditorService.RevealLineAsync(diag.Line);
    }

    // --------------------------------------------------------------------------
    // Global Keyboard Shortcuts
    // --------------------------------------------------------------------------
    private async Task HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F5" && !e.ShiftKey)
        {
            await RunProgramAsync();
        }
        else if (e.Key == "F5" && e.ShiftKey)
        {
            await ExecutionService.StopAsync();
        }
        else if (e.CtrlKey && e.Key == "s" && !e.ShiftKey)
        {
            await SaveFileAsync();
        }
        else if (e.CtrlKey && e.Key == "s" && e.ShiftKey)
        {
            await SaveAsFileAsync();
        }
        else if (e.CtrlKey && e.Key == "n")
        {
            await CreateNewTabAsync();
        }
        else if (e.CtrlKey && e.Key == "o")
        {
            await OpenFileAsync();
        }
        else if (e.CtrlKey && e.Key == "w")
        {
            await RequestCloseTabAsync(ActiveTab);
        }
    }

    // --------------------------------------------------------------------------
    // Terminal Panel Resizer
    // --------------------------------------------------------------------------
    private void StartResizing(MouseEventArgs e)
    {
        isDraggingResizer = true;
        startMouseY = e.ClientY;
        startHeight = panelHeightPx;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (!isDraggingResizer) return;
        var delta = startMouseY - e.ClientY;
        var newHeight = (int)(startHeight + delta);
        panelHeightPx = Math.Clamp(newHeight, 100, 600);
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        isDraggingResizer = false;
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        Loc.OnLanguageChanged -= HandleLanguageChanged;
        EditorService.OnContentChanged -= HandleContentChanged;
        EditorService.OnCursorChanged -= HandleCursorChanged;

        ExecutionService.OnStdOut -= HandleStdOut;
        ExecutionService.OnStdErr -= HandleStdErr;
        ExecutionService.OnInputRequested -= HandleInputRequested;
        ExecutionService.OnStateChanged -= HandleStateChanged;
        ExecutionService.OnDiagnosticsUpdated -= HandleDiagnosticsUpdated;
    }
}
