@page "/not-found"
@namespace GlossaWeb.Pages
@layout MainLayout

<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; background-color:var(--bg-editor); color:var(--text-primary); font-family:'Segoe UI',sans-serif;">
    <div style="font-size:48px; color:var(--border-active); margin-bottom:12px;">
        <i class="bi bi-file-earmark-x"></i>
    </div>
    <h2 style="font-size:20px; font-weight:600; margin-bottom:8px;">404 — Page Not Found</h2>
    <p style="font-size:13px; color:var(--text-secondary); margin-bottom:20px;">The requested page does not exist in Glossa IDE.</p>
    <a href="/" class="toolbar-btn btn-run" style="text-decoration:none; padding:6px 16px;">
        <i class="bi bi-arrow-left"></i>
        <span>Return to Editor</span>
    </a>
</div>